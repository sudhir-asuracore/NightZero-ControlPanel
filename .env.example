# Copy to .env for local Vite development. This is a public API endpoint, not a secret.
VITE_NIGHTZERO_API_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=replace_with_public_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace_with_public_firebase_app_id